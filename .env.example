# Copy to .env and fill in. .env is gitignored.

# Shared secret for the bridge -> server POSTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# Cloudflare Tunnel token, from the Zero Trust dashboard
# (Networks -> Tunnels -> your tunnel -> Install connector).
TUNNEL_TOKEN=

# Your max heart rate. Strain is computed against this.
MAX_HR=190
SLEEP_NEED_HOURS=8
BASELINE_DAYS=30
# Offset from UTC for day boundaries, e.g. -5 US Eastern, 1 for CET.
TZ_OFFSET_HOURS=0

# --- settings pushed to the laptop bridge ---------------------------------
# Anything set here is picked up by the bridge on its next check, so you can
# change how it behaves without touching the laptop. Leave blank to let the
# laptop's own config.toml decide.
#
# Behaviour only: the strap's Bluetooth address and every credential stay
# local to the laptop and are never taken from the server.
BRIDGE_LOG_LEVEL=
BRIDGE_BACKFILL_INTERVAL=
BRIDGE_HEARTBEAT_INTERVAL=
BRIDGE_FORWARD_INTERVAL=
BRIDGE_UPDATE_CHECK_INTERVAL=
BRIDGE_INCLUDE_IMU=
BRIDGE_LIVE_HR=
BRIDGE_BACKFILL=
BRIDGE_ACK_AND_TRIM=
BRIDGE_BATCH_SIZE=
